{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "app/api/chat/route.ts": {
            "memory": 512,
            "maxDuration": 120
        },
        "app/api/parse-hwp-markdown/route.ts": {
            "memory": 1024,
            "maxDuration": 60
        },
        "app/api/markdown-to-hwpx/route.ts": {
            "memory": 1024,
            "maxDuration": 60
        },
        "app/api/convert-pdf-markdown/route.ts": {
            "memory": 1024,
            "maxDuration": 120
        },
        "app/api/**/route.ts": {
            "memory": 256,
            "maxDuration": 10
        },
        "api/markitdown_python.py": {
            "maxDuration": 120,
            "excludeFiles": "{tests/**,**/*.test.ts,**/*.spec.ts,release/**,dist-electron/**,electron-standalone/**}"
        }
    }
}
